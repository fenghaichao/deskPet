{
  "name": "deskpet",
  "version": "1.0.0",
  "description": "Mochi - a Windows desktop pet with focus timer, grip training and AI chat",
  "main": "src/main.js",
  "author": "boco",
  "license": "MIT",
  "scripts": {
    "start": "node launcher.js",
    "dev": "node launcher.js --dev",
    "dist": "electron-builder --win --x64",
    "pack": "electron-builder --win --dir",
    "test": "node test/placement.test.js"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.boco.deskpet",
    "productName": "Mochi",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Mochi"
    }
  }
}
